[0.01054, "o", "\u001b[1;34mmonthly-invoicing\u001b[0m \u001b[2m$\u001b[0m sed -n 44,83p agentiik.yaml\r\n"]
[1.021442, "o", "outputs:\r\n  charged:\r\n    from: { step: charge, port: ok }\r\n  rejected:\r\n    from: { step: charge, port: rejected }\r\n  invoiced:\r\n    from: { step: total, port: ok }\r\n  archived:\r\n    from: { step: archive, port: out }\r\n\r\nsteps:\r\n\r\n  split:\r\n    image: ghcr.io/acme/agk-split:0.1.0\r\n    inputs:\r\n      orders: ${{ workflow.inputs.orders }}\r\n    params:\r\n      currency: ${{ vars.currency }}\r\n    outputs: [ok]\r\n\r\n  charge:\r\n    image: ghcr.io/acme/agk-charge:0.1.0\r\n"]
[1.021457, "o", "    needs:\r\n      - { step: split, port: ok, as: in }\r\n    strategy:\r\n      fan_out: item\r\n      max_parallel: 2\r\n    secrets: [billing_api]\r\n    outputs: [ok, rejected]\r\n\r\n  total:\r\n    image: ghcr.io/acme/agk-total:0.1.0\r\n    needs:\r\n      - { step: charge, port: ok, as: charges }\r\n"]
[1.021485, "o", "      - { step: charge, port: rejected, as: charges }\r\n    merge: wait_all\r\n    params:\r\n      cycle: ${{ workflow.inputs.cycle }}\r\n    outputs: [ok]\r\n"]
[1.021491, "o", "\r\n"]
[3.03122, "o", "\u001b[1;34mmonthly-invoicing\u001b[0m \u001b[2m$\u001b[0m agk validate\r\n"]
[4.072954, "o", "user namespace remapping is off on this daemon and this runner does not require it, so the floor is lifted: a task's files are owned by a real uid on the host, root inside a container is the host's own root, and a process that escapes a container is that account rather than an unprivileged high-numbered one that maps to no real user.\r\n"]
[4.136257, "o", "ghcr.io/acme/agk-charge:0.1.0: charge-order 0.1.0, reads in, writes ok rejected\r\n"]
[4.196984, "o", "ghcr.io/acme/agk-split:0.1.0: split-orders 0.1.0, reads orders, writes ok\r\n"]
[4.253861, "o", "ghcr.io/acme/agk-total:0.1.0: total-charges 0.1.0, reads charges, writes ok\r\n"]
[4.254414, "o", "finance/monthly-invoicing is valid: 4 steps, 4 edges, 2 declared inputs, 4 declared outputs\r\n4 steps held to the manifests of 3 referenced images\r\n"]
[6.267462, "o", "\u001b[1;34mmonthly-invoicing\u001b[0m \u001b[2m$\u001b[0m agk graph --format mermaid\r\n"]
[7.315564, "o", "flowchart LR\r\n\tstep_archive[\"archive<br/>script on alpine:3.21\"]\r\n\tstep_charge[\"charge<br/>ghcr.io/acme/agk-charge:0.1.0<br/>fan_out: item\"]\r\n\tstep_split[\"split<br/>ghcr.io/acme/agk-split:0.1.0\"]\r\n\tstep_total[\"total<br/>ghcr.io/acme/agk-total:0.1.0<br/>merge: wait_all\"]\r\n\r\n\tstep_total -->|\"ok to in\"| step_archive\r\n\tstep_split -->|\"ok to in\"| step_charge\r\n\tstep_charge -->|\"ok to charges\"| step_total\r\n\tstep_charge -->|\"rejected to charges\"| step_total\r\n\r\n\tinput_orders([\"orders\"])\r\n\tinput_orders -. \"orders\" .-> step_split\r\n\toutput_archived([\"archived\"])\r\n\tstep_archive -. \"out\" .-> output_archived\r\n\toutput_charged([\"charged\"])\r\n\tstep_charge -. \"ok\" .-> output_charged\r\n\toutput_invoiced([\"invoiced\"])\r\n\tstep_total -. \"ok\" .-> output_invoiced\r\n\toutput_rejected([\"rejected\"])\r\n\tstep_charge -. \"rejected\" .-> output_rejected\r\n"]
[9.326501, "o", "\u001b[1;34mmonthly-invoicing\u001b[0m \u001b[2m$\u001b[0m agk run --local --inputs inputs.json --secret-file billing_api=billing.key\r\n"]
[10.389301, "o", "the daemon at /Users/francois/.docker/run/docker.sock speaks API 1.55 and runs linux/aarch64\r\n"]
[10.413638, "o", "user namespace remapping is off on this daemon and this runner does not require it, so the floor is lifted: a task's files are owned by a real uid on the host, root inside a container is the host's own root, and a process that escapes a container is that account rather than an unprivileged high-numbered one that maps to no real user.\r\n"]
[10.592989, "o", "    0.0s  split    running\r\n"]
[10.801414, "o", "charge is given a secret and this platform has no tmpfs for the runner to write secret values on, so the value is written into the task's working directory on disk, where it is removed with the container rather than never having been written at all. An operator with a tmpfs names it in /etc/agentiik/runner.toml.\r\n"]
