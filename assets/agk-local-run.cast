[0.009025, "o", "\u001b[1;34mmonthly-invoicing\u001b[0m \u001b[2m$\u001b[0m sed -n 41,80p agentiik.yaml\r\n"]
[1.03644, "o", "outputs:\r\n  charged:\r\n    from: { step: charge, port: ok }\r\n  rejected:\r\n    from: { step: charge, port: rejected }\r\n  invoiced:\r\n    from: { step: total, port: ok }\r\n  archived:\r\n    from: { step: archive, port: out }\r\n\r\nsteps:\r\n\r\n  split:\r\n    image: ghcr.io/acme/agk-split:0.1.0\r\n    inputs:\r\n      orders: ${{ workflow.inputs.orders }}\r\n    params:\r\n      currency: ${{ vars.currency }}\r\n    outputs: [ok]\r\n\r\n  charge:\r\n    image: ghcr.io/acme/agk-charge:0.1.0\r\n    needs:\r\n      - { step: split, port: ok, as: in }\r\n    strategy:\r\n      fan_out: item\r\n      max_parallel: 2\r\n"]
[1.036457, "o", "    secrets: [billing_api]\r\n    outputs: [ok, rejected]\r\n\r\n  total:\r\n    image: ghcr.io/acme/agk-total:0.1.0\r\n    needs:\r\n      - { step: charge, port: ok, as: charges }\r\n      - { step: charge, port: rejected, as: charges }\r\n    merge: wait_all\r\n    params:\r\n      cycle: ${{ workflow.inputs.cycle }}\r\n    outputs: [ok]\r\n\r\n"]
[3.053196, "o", "\u001b[1;34mmonthly-invoicing\u001b[0m \u001b[2m$\u001b[0m agk validate\r\n"]
[4.154192, "o", "user namespace remapping is off on this daemon and this runner does not require it, so the floor is lifted: a task's files are owned by a real uid on the host, root inside a container is the host's own root, and a process that escapes a container is that account rather than an unprivileged high-numbered one that maps to no real user.\r\nthis daemon applies neither an AppArmor profile nor an SELinux label to a container, which is the host's to offer, so a container is held by its namespaces, its dropped capabilities and its seccomp profile with no mandatory access control behind them.\r\n"]
[4.297163, "o", "ghcr.io/acme/agk-charge:0.1.0: charge-order 0.1.0, reads in, writes ok rejected\r\n"]
[4.455871, "o", "ghcr.io/acme/agk-split:0.1.0: split-orders 0.1.0, reads orders, writes ok\r\n"]
[4.546269, "o", "ghcr.io/acme/agk-total:0.1.0: total-charges 0.1.0, reads charges, writes ok\r\n"]
[4.547072, "o", "finance/monthly-invoicing is valid: 4 steps, 4 edges, 2 declared inputs, 4 declared outputs\r\n4 steps held to the manifests of 3 referenced images\r\n"]
[6.556218, "o", "\u001b[1;34mmonthly-invoicing\u001b[0m \u001b[2m$\u001b[0m agk graph --format mermaid\r\n"]
[7.598803, "o", "flowchart LR\r\n\tstep_archive[\"archive<br/>script on alpine:3.21\"]\r\n\tstep_charge[\"charge<br/>ghcr.io/acme/agk-charge:0.1.0<br/>fan_out: item\"]\r\n\tstep_split[\"split<br/>ghcr.io/acme/agk-split:0.1.0\"]\r\n\tstep_total[\"total<br/>ghcr.io/acme/agk-total:0.1.0<br/>merge: wait_all\"]\r\n\r\n\tstep_total -->|\"ok to in\"| step_archive\r\n\tstep_split -->|\"ok to in\"| step_charge\r\n\tstep_charge -->|\"ok to charges\"| step_total\r\n\tstep_charge -->|\"rejected to charges\"| step_total\r\n\r\n\tinput_orders([\"orders\"])\r\n\tinput_orders -. \"orders\" .-> step_split\r\n\toutput_archived([\"archived\"])\r\n\tstep_archive -. \"out\" .-> output_archived\r\n\toutput_charged([\"charged\"])\r\n\tstep_charge -. \"ok\" .-> output_charged\r\n\toutput_invoiced([\"invoiced\"])\r\n\tstep_total -. \"ok\" .-> output_invoiced\r\n\toutput_rejected([\"rejected\"])\r\n\tstep_charge -. \"rejected\" .-> output_rejected\r\n"]
[9.606447, "o", "\u001b[1;34mmonthly-invoicing\u001b[0m \u001b[2m$\u001b[0m agk run --local --inputs inputs.json --secret-file billing_api=billing.key\r\n"]
[10.655269, "o", "the daemon at /Users/francois/.docker/run/docker.sock speaks API 1.56 and runs linux/aarch64\r\n"]
[10.682544, "o", "user namespace remapping is off on this daemon and this runner does not require it, so the floor is lifted: a task's files are owned by a real uid on the host, root inside a container is the host's own root, and a process that escapes a container is that account rather than an unprivileged high-numbered one that maps to no real user.\r\nthis daemon applies neither an AppArmor profile nor an SELinux label to a container, which is the host's to offer, so a container is held by its namespaces, its dropped capabilities and its seccomp profile with no mandatory access control behind them.\r\n"]
