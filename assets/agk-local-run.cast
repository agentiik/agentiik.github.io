[16.363249, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"invoice-2026-01\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"data\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"charged_count\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"charged_total\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m4600\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"cycle\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-01\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"receipts_seen\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"rejected_count\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"files\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"summary.txt\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"uri\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"agk://run/01M3KR0GNGCVCXNMA3JEA74T4V/total/ok/summary.txt\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"media_type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"text/plain\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"size\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m57\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"sha256\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"a7e1875aa928e8a32bed8728639b06e8f8e2e297df096da697c85caffd34075a\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
